# ==============================================================================
# ThesisSlot Environment Configuration Template
# ==============================================================================
# Important: Never commit actual passwords or production secrets to Git.
# Copy this file to `.env` or `.env.local` for local development.

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (MySQL 8.0)
# ------------------------------------------------------------------------------
# Separate from cpetak-timetable (timetable_db / timetable_e2e)
DATABASE_HOST="localhost"
DATABASE_PORT="3306"
DATABASE_NAME="thesis_slot_dev"
DATABASE_USER="root"
DATABASE_PASSWORD="your_mysql_password_here"

# Prisma Database Connection URL
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:your_mysql_password_here@localhost:3306/thesis_slot_dev"

# Future Test Database (for reference only):
# TEST_DATABASE_URL="mysql://root:your_mysql_password_here@localhost:3306/thesis_slot_test"

# ------------------------------------------------------------------------------
# BETTER AUTH CONFIGURATION
# ------------------------------------------------------------------------------
# Generate a secure secret using: openssl rand -base64 32
BETTER_AUTH_SECRET="your_generate_secure_random_better_auth_secret_here"
BETTER_AUTH_URL="http://localhost:3000"
